@{
    ViewData["Title"] = "Política de Privacidad";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-3 mt-4 mb-5">
                <div class="card-header bg-gradient text-white text-center py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="bi bi-shield-lock-fill" style="font-size: 3rem;"></i>
                    <h1 class="mt-3 mb-0">@ViewData["Title"]</h1>
                </div>
                <div class="card-body p-5">
                    <div class="mb-4">
                        <h4 class="text-primary"><i class="bi bi-info-circle-fill me-2"></i>Información General</h4>
                        <p class="text-muted">
                            En Sistema Gestión, nos comprometemos a proteger tu privacidad y garantizar la seguridad de tu información personal.
                            Esta política describe cómo recopilamos, usamos y protegemos tus datos.
                        </p>
                    </div>

                    <hr class="my-4">

                    <div class="mb-4">
                        <h4 class="text-primary"><i class="bi bi-clipboard-data-fill me-2"></i>Recopilación de Datos</h4>
                        <p class="text-muted">Recopilamos la siguiente información:</p>
                        <ul class="list-unstyled ps-4">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Información de identificación personal (nombre, número de empleado)</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Credenciales de acceso al sistema</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Registros de actividad en el sistema</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Información de auditoría y seguimiento</li>
                        </ul>
                    </div>

                    <hr class="my-4">

                    <div class="mb-4">
                        <h4 class="text-primary"><i class="bi bi-gear-fill me-2"></i>Uso de la Información</h4>
                        <p class="text-muted">Utilizamos tu información para:</p>
                        <ul class="list-unstyled ps-4">
                            <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-info me-2"></i>Gestionar tu cuenta y acceso al sistema</li>
                            <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-info me-2"></i>Procesar y administrar documentos</li>
                            <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-info me-2"></i>Generar reportes y análisis</li>
                            <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-info me-2"></i>Mantener la seguridad del sistema</li>
                            <li class="mb-2"><i class="bi bi-arrow-right-circle-fill text-info me-2"></i>Mejorar nuestros servicios</li>
                        </ul>
                    </div>

                    <hr class="my-4">

                    <div class="mb-4">
                        <h4 class="text-primary"><i class="bi bi-shield-check-fill me-2"></i>Seguridad de Datos</h4>
                        <p class="text-muted">
                            Implementamos medidas de seguridad técnicas y organizativas para proteger tu información contra
                            acceso no autorizado, pérdida, destrucción o alteración. Esto incluye:
                        </p>
                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <i class="bi bi-lock-fill text-primary fs-3"></i>
                                        <h6 class="mt-2">Encriptación</h6>
                                        <small class="text-muted">Datos protegidos con encriptación avanzada</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <i class="bi bi-server text-primary fs-3"></i>
                                        <h6 class="mt-2">Servidores Seguros</h6>
                                        <small class="text-muted">Infraestructura protegida y monitoreada</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <i class="bi bi-person-check-fill text-primary fs-3"></i>
                                        <h6 class="mt-2">Control de Acceso</h6>
                                        <small class="text-muted">Autenticación y autorización por roles</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <i class="bi bi-clock-history text-primary fs-3"></i>
                                        <h6 class="mt-2">Auditoría</h6>
                                        <small class="text-muted">Registro completo de actividades</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="mb-4">
                        <h4 class="text-primary"><i class="bi bi-person-badge-fill me-2"></i>Tus Derechos</h4>
                        <p class="text-muted">Como usuario, tienes derecho a:</p>
                        <ul class="list-unstyled ps-4">
                            <li class="mb-2"><i class="bi bi-eye-fill text-warning me-2"></i>Acceder a tu información personal</li>
                            <li class="mb-2"><i class="bi bi-pencil-fill text-warning me-2"></i>Corregir información inexacta</li>
                            <li class="mb-2"><i class="bi bi-trash-fill text-warning me-2"></i>Solicitar la eliminación de tus datos</li>
                            <li class="mb-2"><i class="bi bi-download text-warning me-2"></i>Exportar tu información</li>
                        </ul>
                    </div>

                    <hr class="my-4">

                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                        <div>
                            <strong>¿Tienes preguntas?</strong>
                            <p class="mb-0">
                                Si tienes dudas sobre nuestra política de privacidad, contáctanos en 
                                <a href="mailto:soporte@sistemagestion.com" class="alert-link">soporte@sistemagestion.com</a>
                            </p>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <p class="text-muted mb-0">
                            <small><i class="bi bi-calendar-check-fill me-1"></i>Última actualización: Enero 2025</small>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
