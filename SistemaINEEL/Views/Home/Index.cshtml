@using SistemaINEEL.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<div class="dashboard-wrapper">
    <div>
        <div class="modules-section">
            <div class="section-header">
                <h2 class="section-title">Módulos Disponibles</h2>
                <p class="section-subtitle">Selecciona una opción para comenzar</p>
            </div>
            
            @{
                var rolNormalizado = (Model.NombreRol ?? "usuario").ToLowerInvariant().Trim();
            }
            <div class="dashboard-grid" id="dashboardGrid" data-role="@rolNormalizado"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
