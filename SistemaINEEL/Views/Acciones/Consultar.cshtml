@model IEnumerable<LibreriaModelos.Consecutivo>

@{
    ViewData["Title"] = "Consultar Consecutivos";
    var esAdmin = ViewData["EsAdmin"] as bool? ?? false;
    var nombresUsuarios = ViewData["NombresUsuarios"] as Dictionary<int, string> ?? new Dictionary<int, string>();
    var usuarioIdActual = ViewData["UsuarioIDActual"] as int?;
}

<h1>Consultar Consecutivos</h1>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear Nuevo Consecutivo
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.FolioCompleto)</th>
                    <th>@Html.DisplayNameFor(model => model.Remitente)</th>
                    <th>@Html.DisplayNameFor(model => model.Destinatario)</th>
                    <th>@Html.DisplayNameFor(model => model.Asunto)</th>
                    <th>@Html.DisplayNameFor(model => model.Fecha)</th>
                    <th>Creado por</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var estaCancelado = item.CanceladoPor > 0;
                    var puedeCancelar = !estaCancelado && (esAdmin || (usuarioIdActual.HasValue && item.UsuarioID == usuarioIdActual.Value));
                    <tr class="@(estaCancelado ? "table-secondary" : "")">
                        <td>
                            <strong>@Html.DisplayFor(modelItem => item.FolioCompleto)</strong>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Remitente)</td>
                        <td>@Html.DisplayFor(modelItem => item.Destinatario)</td>
                        <td>@Html.DisplayFor(modelItem => item.Asunto)</td>
                        <td>@Html.DisplayFor(modelItem => item.Fecha)</td>
                        <td>@(nombresUsuarios.ContainsKey(item.UsuarioID) ? nombresUsuarios[item.UsuarioID] : $"Usuario {item.UsuarioID}")</td>
                        <td>
                            @if (estaCancelado)
                            {
                                <span class="badge bg-danger">Cancelado</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                @if (puedeCancelar)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning btn-cancelar" 
                                            data-id="@item.ConsecutivoID" 
                                            data-folio="@item.FolioCompleto"
                                            title="Cancelar">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                }
                                @if (esAdmin)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar" 
                                            data-id="@item.ConsecutivoID" 
                                            data-folio="@item.FolioCompleto"
                                            title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i> No hay consecutivos registrados. 
        <a asp-action="Crear" class="alert-link">Crear el primer consecutivo</a>
    </div>
}

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Volver al Dashboard
    </a>
</div>

<div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="modalCancelarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCancelarLabel">Cancelar Consecutivo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro de que desea cancelar el consecutivo <strong id="folioCancelar"></strong>?</p>
                <p class="text-muted small">Esta acción marcará el consecutivo como cancelado, pero seguirá siendo visible en la consulta.</p>
                <div class="mb-3">
                    <label for="motivoCancelacion" class="form-label">Motivo de cancelación <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="motivoCancelacion" rows="4" maxlength="500" placeholder="Ingrese el motivo de la cancelación..." required></textarea>
                    <div class="form-text">
                        <span id="contadorCaracteres">0</span>/500 caracteres
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-warning" id="btnConfirmarCancelar">
                    <i class="bi bi-x-circle"></i> Confirmar Cancelación
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.accionesUrls = {
            cancelar: '@Url.Action("Cancelar", "Acciones")',
            eliminar: '@Url.Action("Eliminar", "Acciones")'
        };
    </script>
    <script src="~/js/acciones-consultar.js" asp-append-version="true"></script>
}
