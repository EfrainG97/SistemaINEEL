@model IEnumerable<LibreriaModelos.Consecutivo>

@{
    ViewData["Title"] = "Consultar Consecutivos";
    var esAdmin = ViewData["EsAdmin"] as bool? ?? false;
}

<h1>Consultar Consecutivos</h1>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear Nuevo Consecutivo
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.FolioCompleto)</th>
                    <th>@Html.DisplayNameFor(model => model.Remitente)</th>
                    <th>@Html.DisplayNameFor(model => model.Destinatario)</th>
                    <th>@Html.DisplayNameFor(model => model.Asunto)</th>
                    <th>@Html.DisplayNameFor(model => model.Fecha)</th>
                    <th>@Html.DisplayNameFor(model => model.UsuarioID)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@Html.DisplayFor(modelItem => item.FolioCompleto)</strong>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Remitente)</td>
                        <td>@Html.DisplayFor(modelItem => item.Destinatario)</td>
                        <td>@Html.DisplayFor(modelItem => item.Asunto)</td>
                        <td>@Html.DisplayFor(modelItem => item.Fecha)</td>
                        <td>@Html.DisplayFor(modelItem => item.UsuarioID)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Ver detalles">
                                    <i class="bi bi-eye"></i>
                                </button>
                                @if (esAdmin)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar" 
                                            data-id="@item.ConsecutivoID" 
                                            data-folio="@item.FolioCompleto"
                                            title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i> No hay consecutivos registrados. 
        <a asp-action="Crear" class="alert-link">Crear el primer consecutivo</a>
    </div>
}

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Volver al Dashboard
    </a>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-eliminar').on('click', function() {
                var consecutivoId = $(this).data('id');
                var folio = $(this).data('folio');
                
                if (confirm('¿Está seguro de que desea eliminar el consecutivo "' + folio + '"?\n\nEsta acción no se puede deshacer.')) {
                    $.ajax({
                        url: '@Url.Action("Eliminar", "Acciones")',
                        type: 'POST',
                        data: { id: consecutivoId },
                        success: function(response) {
                            if (response.success) {
                                alert('Consecutivo eliminado exitosamente');
                                location.reload();
                            } else {
                                alert('Error: ' + (response.message || 'No se pudo eliminar el consecutivo'));
                            }
                        },
                        error: function() {
                            alert('Error al eliminar el consecutivo. Por favor, intente nuevamente.');
                        }
                    });
                }
            });
        });
    </script>
}
