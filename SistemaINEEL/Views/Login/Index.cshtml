@using SistemaINEEL.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Gestión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="floating-shapes">
        <div class="shape shape1"></div>
        <div class="shape shape2"></div>
    </div>

    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <i class="bi bi-shield-lock-fill"></i>
                <h2>Bienvenido</h2>
                <p>Inicia sesión en el Sistema de Gestión</p>
            </div>

            <div class="login-body">
                @if (Model.HasError)
                {
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }

                <form asp-controller="Login" asp-action="Login" method="post">
                    <div class="form-floating">
                        <input asp-for="NumEmpleado" type="text" class="form-control" id="floatingNumEmpleado" placeholder="Número de Empleado" required />
                        <label for="floatingNumEmpleado">
                            <i class="bi bi-person-badge-fill me-2"></i>Número de Empleado
                        </label>
                        <span asp-validation-for="NumEmpleado" class="text-danger"></span>
                    </div>

                    <div class="form-floating">
                        <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Contraseña" required />
                        <label for="floatingPassword">
                            <i class="bi bi-lock-fill me-2"></i>Contraseña
                        </label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-login">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                    </button>
                </form>

                <div class="divider">
                    <span>Credenciales de prueba</span>
                </div>

                <div class="credentials-info">
                    <div class="mb-2">
                        <i class="bi bi-person-badge-fill me-2"></i>
                        <strong>SysAdmin:</strong> empleado: <code>1001</code> / contraseña: <code>syspass</code>
                    </div>
                    <div>
                        <i class="bi bi-person-fill me-2"></i>
                        <strong>Administrador:</strong> empleado: <code>1002</code> / contraseña: <code>pass</code>
                    </div>
                    <div>
                        <i class="bi bi-person-fill me-2"></i>
                        <strong>Usuario:</strong> empleado: <code>1003</code> / contraseña: <code>user</code>
                    </div>
                </div>
                <div class="info-text">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    ¿Problemas para iniciar sesión? Contacta al administrador
                </div>
            </div>
        </div>

        <div class="text-center mt-4 text-white">
            <small>
                <i class="bi bi-c-circle me-1"></i>2025 Sistema Gestión - Todos los derechos reservados
            </small>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>