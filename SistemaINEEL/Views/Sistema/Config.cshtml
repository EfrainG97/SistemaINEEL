@{
    ViewData["Title"] = "Configuración del Sistema";
    var gerenciaActual = ViewData["GerenciaActual"]?.ToString() ?? "No definida";
    var sistemaId = ViewData["SistemaId"]?.ToString() ?? "1";
}

<link rel="stylesheet" href="~/css/config.css" />

<div class="container-config">
    <div class="header-config">
        <h1>Configuración del Sistema</h1>
        <p class="subtitle">Gestión de gerencias y usuarios</p>
    </div>

    <div class="grid-formularios">
        <div class="seccion-config">
            <h2>Editar Gerencia</h2>
            <div class="current-value">Gerencia actual: <strong id="gerenciaActualLabel">@gerenciaActual</strong></div>
            <form id="formEditarGerencia">
                <input type="hidden" id="sistemaId" value="@sistemaId" />
                <div class="form-group">
                    <label for="nuevaGerencia">Nueva Gerencia:</label>
                    <input type="text" id="nuevaGerencia" name="nuevaGerencia" placeholder="Ingrese el nombre de la gerencia" required />
                </div>
                <button type="submit" class="btn-submit">Actualizar Gerencia</button>
            </form>
        </div>

        <div class="seccion-config">
            <h2>Crear Usuario</h2>
            <form id="formCrearUsuario">
                <div class="form-group">
                    <label for="numEmpleado">Número de Empleado:</label>
                    <input type="number" id="numEmpleado" name="numEmpleado" placeholder="Ej: 12345" required />
                </div>
                <div class="form-group">
                    <label for="nombreUsuario">Nombre de Usuario:</label>
                    <input type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Ej: jdoe" required />
                </div>
                <div class="form-group">
                    <label for="password">Contraseña:</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required />
                </div>
                <div class="form-group">
                    <label for="rol">Rol:</label>
                    <select id="rol" name="rol" required>
                        <option value="">Seleccione un rol</option>
                        <option value="1">Admin</option>
                        <option value="2">Usuario</option>
                    </select>
                </div>
                <button type="submit" class="btn-submit">Crear Usuario</button>
            </form>
        </div>
    </div>

    <div class="seccion-config seccion-tabla">
        <div class="header-tabla">
            <h2>Usuarios del Sistema</h2>
            <button id="btnCargarUsuarios" class="btn-load">
                <span></span> Cargar Usuarios
            </button>
        </div>
        <div class="table-container">
            <table id="tablaUsuarios">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Num. Empleado</th>
                        <th>Nombre Usuario</th>
                        <th>Rol</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaUsuariosBody">
                    <tr>
                        <td colspan="5" class="empty-state">
                            <div class="empty-message">
                                <span></span>
                                <p>Haga clic en "Cargar Usuarios" para ver los datos</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal para Editar Usuario -->
    <div id="modalEditarUsuario" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>✏️ Editar Usuario</h2>
            <form id="formEditarUsuario">
                <input type="hidden" id="editUsuarioId" />
                <div class="form-group">
                    <label for="editNumEmpleado">Número de Empleado:</label>
                    <input type="number" id="editNumEmpleado" name="editNumEmpleado" required />
                </div>
                <div class="form-group">
                    <label for="editNombreUsuario">Nombre de Usuario:</label>
                    <input type="text" id="editNombreUsuario" name="editNombreUsuario" required />
                </div>
                <div class="form-group">
                    <label for="editPassword">Contraseña:</label>
                    <input type="password" id="editPassword" name="editPassword" required />
                </div>
                <div class="form-group">
                    <label for="editRol">Rol:</label>
                    <select id="editRol" name="editRol" required>
                        <option value="1">Admin</option>
                        <option value="2">Usuario</option>
                    </select>
                </div>
                <button type="submit" class="btn-submit">Guardar Cambios</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/config.js"></script>
}
