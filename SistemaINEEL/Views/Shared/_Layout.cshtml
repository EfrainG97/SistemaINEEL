<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - INEEL Sistema de Gestión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo-ineel.png" alt="INEEL" class="navbar-logo" />
                <span class="brand-text">Sistema de Gestión</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door-fill"></i>
                            <span>Inicio</span>
                        </a>
                    </li>
                    @if (Context.Session.GetString("UsuarioLogeado") == "true")
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Acciones/Crear">
                                <i class="bi bi-plus-circle-fill"></i>
                                <span>Crear</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Acciones/Reportes">
                                <i class="bi bi-file-earmark-bar-graph-fill"></i>
                                <span>Reportes</span>
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (Context.Session.GetString("UsuarioLogeado") == "true")
                    {
                        <li class="nav-item dropdown user-dropdown">
                            <a class="nav-link dropdown-toggle user-menu" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <span class="user-name">@Context.Session.GetString("NombreUsuario")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu">
                                <li class="dropdown-header">
                                    <div class="user-info">
                                        <i class="bi bi-person-circle"></i>
                                        <div class="user-details">
                                            <strong>@Context.Session.GetString("NombreUsuario")</strong>
                                            <small>@Context.Session.GetString("NombreRol")</small>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item logout-item" asp-controller="Login" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Cerrar Sesion</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-login-nav" asp-controller="Login" asp-action="Index">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Iniciar Sesion</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="main-wrapper">
        <main role="main" class="main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 footer-section">
                    <div class="footer-logo-container">
                        <img src="~/images/logo-ineel.png" alt="INEEL" class="footer-logo" />
                    </div>
                    <p class="footer-description">
                        Instituto Nacional de Electricidad y Energías Limpias - Sistema integral para la gestión y administración de documentos.
                    </p>
                </div>
                <div class="col-md-6 footer-section text-md-end">
                    <p class="footer-contact">
                        <i class="fas fa-map-marker-alt me-2"></i>Reforma 113, Col. Palmira, Cuernavaca, Morelos
                    </p>
                </div>
            </div>
            <hr class="footer-divider">
            <div class="footer-bottom">
                <p class="mb-0">
                    <i class="far fa-copyright"></i> 2025 INEEL - Instituto Nacional de Electricidad y Energías Limpias
                </p>
            </div>
        </div>
    </footer>

    <button id="scrollTopBtn" class="scroll-top-btn" title="Volver arriba">
        <i class="bi bi-arrow-up-circle-fill"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
